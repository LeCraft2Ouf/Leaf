+    public static String versionBanner() {
+        return ">>> " + BUILD_TAG + " build " + BUILD_ID + " <<<";
+    }
+
+    public static String jarHint() {
+        return "JAR attendu : " + EXPECTED_JAR;
+    }
+
+    public static String patchSummary() {
+        return "Patches actifs : fèves sans lumière, cultures sans lumière, enhance_soil melon, Nexo cactus/tiges";
+    }
+
+    public static String wrongJarWarning() {
+        return "Si NEODIUM-FARMRUN n'apparaît pas ici, ce n'est PAS le bon jar.";
+    }
+}
