diff --git a/src/main/java/org/bukkit/craftbukkit/neodium/NexoCustomBlockHelper.java b/src/main/java/org/bukkit/craftbukkit/neodium/NexoCustomBlockHelper.java
new file mode 100644
index 0000000000000000000000000000000000000000..0a9065a59317e735f16e07a0f35cdf2dd60e2c4b
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/neodium/NexoCustomBlockHelper.java
@@ -0,0 +1,72 @@
+package org.bukkit.craftbukkit.neodium;
+
+import java.lang.reflect.Method;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.LevelAccessor;
+import org.bukkit.Bukkit;
+import org.bukkit.Material;
+import org.bukkit.block.Block;
+import org.bukkit.craftbukkit.block.CraftBlock;
+import org.bukkit.plugin.Plugin;
+
+/**
+ * Résolution des blocs custom Nexo depuis le code serveur.
+ * Les classes Nexo sont dans le classloader du plugin Nexo : {@code Class.forName} sans ce classloader échoue.
+ */
+public final class NexoCustomBlockHelper {
+
+    private NexoCustomBlockHelper() {
+    }
+
+    public static boolean isMechanicBase(Block block) {
+        if (block == null) {
+            return false;
+        }
+        Material t = block.getType();
+        return t == Material.NOTE_BLOCK
+            || t == Material.BROWN_MUSHROOM_BLOCK
+            || t == Material.RED_MUSHROOM_BLOCK
+            || t == Material.MUSHROOM_STEM;
+    }
+
+    public static boolean isMechanicBase(BlockGetter level, BlockPos pos) {
+        if (!(level instanceof LevelAccessor accessor)) {
+            return false;
+        }
+        return isMechanicBase(CraftBlock.at(accessor, pos));
+    }
+
+    /**
+     * @param expectedId ex. {@code enhance_sand}, {@code enhance_soil}
+     */
+    public static boolean matchesCustomBlockId(BlockGetter level, BlockPos pos, String expectedId) {
+        if (!(level instanceof LevelAccessor accessor)) {
+            return false;
+        }
+        return matchesCustomBlockId(CraftBlock.at(accessor, pos), expectedId);
+    }
+
+    public static boolean matchesCustomBlockId(Block bukkitBlock, String expectedId) {
+        if (!isMechanicBase(bukkitBlock)) {
+            return false;
+        }
+        Plugin nexo = Bukkit.getPluginManager().getPlugin("Nexo");
+        if (nexo == null || !nexo.isEnabled()) {
+            return false;
+        }
+        try {
+            Class<?> nexoBlocksClass = Class.forName("com.nexomc.nexo.api.NexoBlocks", true, nexo.getClass().getClassLoader());
+            Method method = nexoBlocksClass.getMethod("customBlockMechanic", Block.class);
+            Object mechanic = method.invoke(null, bukkitBlock);
+            if (mechanic == null) {
+                return false;
+            }
+            Object idObj = mechanic.getClass().getMethod("getItemID").invoke(mechanic);
+            String id = idObj == null ? "" : idObj.toString();
+            return expectedId.equals(id) || id.endsWith(":" + expectedId) || id.endsWith("/" + expectedId);
+        } catch (Throwable ignored) {
+            return false;
+        }
+    }
+}
