+    private static Component pageNavLink(final String label, final int targetPage) {
+        final String cmd = "/plugins " + targetPage;
+        final String alt = "/pl " + targetPage;
+        return Component.text(label, Style.style(NamedTextColor.AQUA, TextDecoration.UNDERLINED)
+            .clickEvent(ClickEvent.runCommand(cmd))
+            .hoverEvent(HoverEvent.showText(Component.text()
+                .append(Component.text("Aller à la page ", NamedTextColor.GRAY))
+                .append(Component.text(String.valueOf(targetPage), NamedTextColor.WHITE))
+                .appendNewline()
+                .append(Component.text("Clic : ", NamedTextColor.DARK_GRAY))
+                .append(Component.text(cmd, NamedTextColor.YELLOW))
+                .appendNewline()
+                .append(Component.text("Raccourci : ", NamedTextColor.DARK_GRAY))
+                .append(Component.text(alt, NamedTextColor.YELLOW))
+                .build())));
+    }
+
+    private static Component buildFooter(final int page, final int totalPages) {
+        final TextComponent.Builder footer = Component.text();
+        footer.append(Component.text("——— ", NamedTextColor.DARK_GRAY));
+        footer.append(Component.text("Page ", NamedTextColor.GRAY));
+        footer.append(Component.text(page + "/" + totalPages, NamedTextColor.WHITE));
+        if (page > 1) {
+            footer.appendSpace();
+            footer.append(pageNavLink("« précédent", page - 1));
+        }
+        if (page < totalPages) {
+            footer.appendSpace();
+            footer.append(pageNavLink("suivant »", page + 1));
+        }
+        return footer.build();
+    }
 }
